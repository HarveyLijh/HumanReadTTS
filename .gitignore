# Swift Package Manager
.build/
Packages/*/.build/
.swiftpm/
# The app's Package.resolved IS tracked on purpose — CI has no lockfile
# otherwise and resolves dependencies fresh, which is how the v0.7.2
# release build broke. Only ignore resolved files inside checkouts.
**/SourcePackages/**/Package.resolved

# Local config (signing identity, team ID)
Configs/Local.xcconfig

